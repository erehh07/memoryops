# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- LLM (Groq) ---
# Without a key the agent runs in "offline" mode: a deterministic precedent matcher,
# shown in the UI as "LLM: offline". It never invents precedents either.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# --- Memory (Hindsight) ---
# auto  = use Hindsight if HINDSIGHT_BASE_URL or HINDSIGHT_API_KEY is set and the server answers,
#         otherwise the local fallback (UI badge: "Memory: local fallback")
# hindsight / local = force one backend
MEMORY_BACKEND=auto
# Hindsight Cloud: https://api.hindsight.vectorize.io   Self-hosted (docker): http://localhost:8888
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=memoryops-ap
# Optional: seconds to wait for Hindsight calls
HINDSIGHT_TIMEOUT=60

# --- App ---
DB_PATH=backend/var/memoryops.db
LOCAL_MEMORY_PATH=backend/var/local_memory.json
# Price variance tolerance (percent). Variances strictly above this are exceptions.
PRICE_TOLERANCE_PCT=0.5
